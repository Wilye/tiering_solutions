+static DECLARE_WAIT_QUEUE_HEAD(arms_dma_wq);
+#define ARMS_MAX_SIZE_PER_DMA_REQUEST (2 * 1024 * 1024)
+#define ARMS_MAX_DMA_CHANS 16
+static u32 arms_size_per_dma_request = ARMS_MAX_SIZE_PER_DMA_REQUEST;
+static struct dma_chan *arms_chans[ARMS_MAX_DMA_CHANS];
+static int arms_num_chans;
+
+struct arms_tx_dma_param {
+	atomic_t wakeup_count;
+	u64 expect_count;
+};
+
+/*
+ * DMA completion callbacks run in softirq/tasklet context — no sleeping.
+ * Use an atomic counter instead of a mutex to track completions.
+ */
+static void arms_dma_tx_callback(void *dma_async_param)
+{
+	struct arms_tx_dma_param *p = (struct arms_tx_dma_param *)dma_async_param;
+
+	if ((u64)atomic_inc_return(&p->wakeup_count) >= p->expect_count)
+		wake_up_interruptible(&arms_dma_wq);
+}
+
+/*
+ * bad_address - safely probe a kernel pointer.
+ * Returns non-zero if the address is not safely readable.
+ * In 5.1 this used probe_kernel_address(); in 6.18 use get_kernel_nofault().
+ */
+static int arms_bad_address(void *p)
+{
+	unsigned long dummy;
+
+	return get_kernel_nofault(dummy, (unsigned long *)p);
+}
+
+/*
+ * page_walk - translate a virtual address to its physical address by
+ * walking the current page tables directly via CR3.  Result is written
+ * to *phy_addr on success; on failure *phy_addr is left unchanged and
+ * a warning is printed.
+ */
+static void arms_page_walk(u64 address, u64 *phy_addr)
+{
+	pgd_t *base = __va(read_cr3_pa());
+	pgd_t *pgd = base + pgd_index(address);
+	p4d_t *p4d;
+	pud_t *pud;
+	pmd_t *pmd;
+	pte_t *pte;
+	u64 page_addr;
+	u64 page_offset;
+
+	if (arms_bad_address(pgd))
+		goto out;
+	if (!pgd_present(*pgd))
+		goto out;
+
+	p4d = p4d_offset(pgd, address);
+	if (arms_bad_address(p4d))
+		goto out;
+	if (!p4d_present(*p4d) || p4d_leaf(*p4d))
+		goto out;
+
+	pud = pud_offset(p4d, address);
+	if (arms_bad_address(pud))
+		goto out;
+	if (!pud_present(*pud) || pud_leaf(*pud))
+		goto out;
+
+	pmd = pmd_offset(pud, address);
+	if (arms_bad_address(pmd))
+		goto out;
+
+	if (pmd_leaf(*pmd)) {
+		page_addr   = pmd_val(*pmd) & 0x000FFFFFFFE00000ULL;
+		page_offset = address & ~HPAGE_MASK;
+		*phy_addr   = page_addr | page_offset;
+		return;
+	}
+
+	if (!pmd_present(*pmd))
+		goto out;
+
+	pte = pte_offset_kernel(pmd, address);
+	if (arms_bad_address(pte))
+		goto out;
+
+	page_addr   = pte_val(*pte) & 0x000FFFFFFFFFF000ULL;
+	page_offset = address & ~PAGE_MASK;
+	*phy_addr   = page_addr | page_offset;
+	return;
+
+out:
+	pr_warn("arms: arms_page_walk: bad address 0x%llx\n", address);
+}
+
+int dma_request_channs(struct uffdio_dma_channs *uffdio_dma_channs)
+{
+	dma_cap_mask_t mask;
+	int i, n;
+
+	if (!uffdio_dma_channs)
+		return -EINVAL;
+
+	/* Release any channels left over from a previous process that crashed
+	 * without calling UFFDIO_DMA_RELEASE_CHANNS. */
+	if (arms_num_chans > 0) {
+		pr_info("arms: releasing %d stale DMA channel(s) from previous run\n",
+			arms_num_chans);
+		dma_release_channs();
+	}
+
+	arms_size_per_dma_request = uffdio_dma_channs->size_per_dma_request;
+	if (arms_size_per_dma_request > ARMS_MAX_SIZE_PER_DMA_REQUEST)
+		arms_size_per_dma_request = ARMS_MAX_SIZE_PER_DMA_REQUEST;
+
+	n = min_t(u32, uffdio_dma_channs->num_channs, ARMS_MAX_DMA_CHANS);
+	if (n == 0)
+		n = 1;
+
+	dma_cap_zero(mask);
+	dma_cap_set(DMA_MEMCPY, mask);
+
+	for (i = 0; i < n; i++) {
+		arms_chans[i] = dma_request_channel(mask, NULL, NULL);
+		if (!arms_chans[i]) {
+			pr_err("arms: dma_request_channel failed for channel %d/%d\n",
+			       i + 1, n);
+			while (--i >= 0) {
+				dma_release_channel(arms_chans[i]);
+				arms_chans[i] = NULL;
+			}
+			arms_num_chans = 0;
+			return -ENODEV;
+		}
+		pr_info("arms: acquired DMA channel %d: %s\n", i,
+			dma_chan_name(arms_chans[i]));
+	}
+	arms_num_chans = n;
+	return 0;
+}
+
+int dma_release_channs(void)
+{
+	int i;
+
+	for (i = 0; i < arms_num_chans; i++) {
+		if (arms_chans[i]) {
+			dma_release_channel(arms_chans[i]);
+			arms_chans[i] = NULL;
+		}
+	}
+	arms_num_chans = 0;
+	arms_size_per_dma_request = ARMS_MAX_SIZE_PER_DMA_REQUEST;
+	return 0;
+}
