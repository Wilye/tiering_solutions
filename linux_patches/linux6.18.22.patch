+static ssize_t __dma_mcopy_pages(struct userfaultfd_ctx *ctx,
+				 struct uffdio_dma_copy *uffdio_dma_copy)
+{
+	struct mm_struct *dst_mm = ctx->mm;
+	ssize_t err;
+	long copied = 0;
+	u64 src_start, dst_start;
+	u64 src_cur, dst_cur, len_cur;
+	dma_addr_t src_phys, dst_phys;
+	u64 len, dma_len;
+	struct dma_chan *chan;
+	struct dma_async_tx_descriptor *tx;
+	dma_cookie_t dma_cookie;
+	u64 count, expect_count;
+	struct arms_tx_dma_param tx_param;
+	int index;
+
+	down_read(&dst_mm->mmap_lock);
+
+	err = -EAGAIN;
+	if (atomic_read(&ctx->mmap_changing))
+		goto out_unlock;
+
+	BUG_ON(!uffdio_dma_copy);
+	count = uffdio_dma_copy->count;
+
+	/* compute total number of DMA transactions needed */
+	expect_count = 0;
+	for (index = 0; index < count; index++) {
+		u64 l = uffdio_dma_copy->len[index];
+
+		expect_count += DIV_ROUND_UP(l, arms_size_per_dma_request);
+	}
+
+	atomic_set(&tx_param.wakeup_count, 0);
+	tx_param.expect_count = expect_count;
+
+	for (index = 0; index < count; index++) {
+		dst_start = uffdio_dma_copy->dst[index];
+		src_start = uffdio_dma_copy->src[index];
+		len       = uffdio_dma_copy->len[index];
+
+		BUG_ON(dst_start & ~PAGE_MASK);
+		BUG_ON(len & ~PAGE_MASK);
+		BUG_ON(src_start + len <= src_start);
+		BUG_ON(dst_start + len <= dst_start);
+
+		src_phys = 0;
+		dst_phys = 0;
+		arms_page_walk(src_start, &src_phys);
+		arms_page_walk(dst_start, &dst_phys);
+
+		for (src_cur = src_start, dst_cur = dst_start, len_cur = 0;
+		     len_cur < len;) {
+			err = 0;
+			chan = arms_chans[index % arms_num_chans];
+			dma_len = min_t(u64, len - len_cur,
+					arms_size_per_dma_request);
+
+			tx = dmaengine_prep_dma_memcpy(chan, dst_phys, src_phys,
+						       dma_len,
+						       DMA_PREP_INTERRUPT |
+						       DMA_CTRL_ACK);
+			if (!tx) {
+				pr_err("arms: dmaengine_prep_dma_memcpy failed\n");
+				err = -EIO;
+				goto out_unlock;
+			}
+
+			tx->callback       = arms_dma_tx_callback;
+			tx->callback_param = &tx_param;
+			dma_cookie = dmaengine_submit(tx);
+			if (dma_submit_error(dma_cookie)) {
+				pr_err("arms: DMA submit error\n");
+				err = -EIO;
+				goto out_unlock;
+			}
+
+			dma_async_issue_pending(chan);
+			len_cur  += dma_len;
+			src_cur  += dma_len;
+			dst_cur  += dma_len;
+			src_phys += dma_len;
+			dst_phys += dma_len;
+		}
+	}
+
+	wait_event_interruptible(arms_dma_wq,
+				 (u64)atomic_read(&tx_param.wakeup_count) >=
+				 tx_param.expect_count);
+
+	for (index = 0; index < count; index++)
+		copied += uffdio_dma_copy->len[index];
+
+out_unlock:
+	up_read(&dst_mm->mmap_lock);
+
+	BUG_ON(copied < 0);
+	BUG_ON(err > 0);
+	BUG_ON(!copied && !err);
+	return copied ? copied : err;
+}
+
+ssize_t dma_mcopy_pages(struct userfaultfd_ctx *ctx,
+			struct uffdio_dma_copy *uffdio_dma_copy)
+{
+	return __dma_mcopy_pages(ctx, uffdio_dma_copy);
+}
